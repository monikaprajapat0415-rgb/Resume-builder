# Copy this file to .env and fill it in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here

# Model id. Check docs.anthropic.com for the current names.
CLAUDE_MODEL=claude-sonnet-5-5

PORT=3000

# Optional: used by the cost estimate in lesson 3.
# Copy the current prices per million tokens from Anthropic's pricing page.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PRICE_CURRENCY=USD
